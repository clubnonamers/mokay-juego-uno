        "secondarySkullId",
        "unlockedSkulls",
        "equippedRelics",
        "heroLevel",
        "heroXp",
        "statPoints",
        "atkBonus",
        "hpBonus",
        "spdBonus",
        "weaponLevel",
        "shieldLevel",
        "worldSeed",
        "playerX",
        "playerY",
        "currentZone",
        "currentRoomIndex",
        "roomsClearedCount",
        "skullSwapsCount",
        "sparksCurrency",
        "totalEnemiesDefeated",
        "molotovBossDefeated",
        "playTimeSeconds",
        "equippedPets",
        "unlockedPets",
        "unlockedCosmetics",
        "unlockedGestures",
        "completedMissionIds",
        "claimedMissionIds",
        "inventoryCounts",
        "createdAt",
        "updatedAt"
