{
  "entities": {
    "SaveSlot": {
      "title": "SaveSlot",
      "description": "Skul-inspired 2D Mokayverse action-platformer roguelite save slot storing Boxy protagonist gear (100% Mokay Streetwear), dual swappable Skull/Match forms, up to 6 passive Relics, weapon/shield levels, max-3 companion pets, missions, and room progress.",
