        "slotLabel": { "type": "string" },
        "heroName": { "type": "string" },
        "headgearId": { "type": "string" },
        "jacketId": { "type": "string" },
        "pantsShoesId": { "type": "string" },
        "backpackId": { "type": "string" },
        "activeSkullId": { "type": "string" },
        "secondarySkullId": { "type": "string" },
        "unlockedSkulls": { "type": "array" },
        "equippedRelics": { "type": "array" },
        "heroLevel": { "type": "integer" },
        "heroXp": { "type": "integer" },
        "statPoints": { "type": "integer" },
        "atkBonus": { "type": "integer" },
        "hpBonus": { "type": "integer" },
        "spdBonus": { "type": "integer" },
        "weaponLevel": { "type": "integer" },
        "shieldLevel": { "type": "integer" },
        "worldSeed": { "type": "integer" },
        "playerX": { "type": "number" },
        "playerY": { "type": "number" },
        "currentZone": {
          "type": "string",
          "enum": [
            "ALDEA_MOKAY",
            "BOSQUE_ESMERALDA",
            "DESIERTO_DORADO",
            "CAVERNAS_MINA",
            "BARRIO_SOMBRAVIA"
          ]
        },
        "currentRoomIndex": { "type": "integer" },
        "roomsClearedCount": { "type": "integer" },
        "skullSwapsCount": { "type": "integer" },
        "sparksCurrency": { "type": "integer" },
        "totalEnemiesDefeated": { "type": "integer" },
        "molotovBossDefeated": { "type": "boolean" },
        "playTimeSeconds": { "type": "integer" },
        "equippedPets": { "type": "array" },
        "unlockedPets": { "type": "array" },
        "unlockedCosmetics": { "type": "array" },
        "unlockedGestures": { "type": "array" },
        "completedMissionIds": { "type": "array" },
        "claimedMissionIds": { "type": "array" },
        "inventoryCounts": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
